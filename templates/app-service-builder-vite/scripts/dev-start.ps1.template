[CmdletBinding()]
param([switch]$Help, [switch]$SkipSkill, [switch]$Clean)
$ErrorActionPreference = "Stop"

if ($Help) {
  Write-Output "Usage: ./scripts/dev-start.ps1 [-SkipSkill] [-Clean]"
  exit 0
}

$Root = Split-Path -Parent $PSScriptRoot
$ForceClean = $Clean.IsPresent -or ($env:FORCE_CLEAN -eq "1")
$RunDir = Join-Path $Root ".dev-run"
. (Join-Path $PSScriptRoot "load-ports.ps1")
Import-AppPorts $Root
$WebPort = if ($env:WEB_PORT) { [int]$env:WEB_PORT } else { 8080 }
$AgentPort = if ($env:AGENT_PORT) { [int]$env:AGENT_PORT } else { 8088 }
$SkillPort = if ($env:SKILL_PORT) { [int]$env:SKILL_PORT } else { 7071 }
$env:WEB_PORT = "$WebPort"
$env:AGENT_PORT = "$AgentPort"
$env:AGENT_URL = "http://127.0.0.1:$AgentPort"
& (Join-Path $PSScriptRoot "dev-stop.ps1") | Out-Null
if ($LASTEXITCODE -ne 0) { throw "The previous app processes could not be stopped safely." }
New-Item -ItemType Directory -Force -Path $RunDir | Out-Null
$IndexUrl = if ($env:PIP_INDEX_URL) { $env:PIP_INDEX_URL } elseif ($env:UV_INDEX_URL) { $env:UV_INDEX_URL } else { $env:UV_DEFAULT_INDEX }
if ($IndexUrl) { $env:PIP_INDEX_URL = $env:UV_INDEX_URL = $env:UV_DEFAULT_INDEX = $IndexUrl }

function Wait-Port($Name, $Port, $Process) {
  for ($i = 0; $i -lt 200; $i++) {
    if ($Process.HasExited) { throw "$Name exited before opening port $Port" }
    if (Test-NetConnection 127.0.0.1 -Port $Port -InformationLevel Quiet -WarningAction SilentlyContinue) {
      Write-Host "[$Name] READY on port $Port"
      return
    }
    Start-Sleep -Milliseconds 150
  }
  throw "$Name timed out opening port $Port"
}

if ($ForceClean) {
  Write-Host "Cleaning node_modules and dist (-Clean)..."
  foreach ($dir in @("node_modules", "dist")) {
    $target = Join-Path $Root $dir
    if (Test-Path $target) {
      Remove-Item -Recurse -Force $target
    }
  }
}

if (-not (Test-Path (Join-Path $Root "node_modules/vite"))) {
  Push-Location $Root
  try {
    npm install --prefer-offline --ignore-scripts --no-audit --no-fund
    if ($LASTEXITCODE -ne 0) { throw "Web dependency installation failed (exit $LASTEXITCODE)." }
  } finally { Pop-Location }
}
$DistIndex = Join-Path $Root "dist/index.html"
$NeedsBuild = $ForceClean -or (-not (Test-Path $DistIndex))
if (-not $NeedsBuild) {
  $DistTime = (Get-Item $DistIndex).LastWriteTimeUtc
  foreach ($srcRel in @("index.html", "src/main.ts", "vite.config.mjs")) {
    $srcPath = Join-Path $Root $srcRel
    if ((Test-Path $srcPath) -and ((Get-Item $srcPath).LastWriteTimeUtc -gt $DistTime)) {
      $NeedsBuild = $true
    }
  }
}
if ($NeedsBuild) {
  Push-Location $Root
  try {
    npm run build
    if ($LASTEXITCODE -ne 0) { throw "Web build failed (exit $LASTEXITCODE)." }
  } finally { Pop-Location }
}

$processes = @()
function Save-ProcessState {
  if ($script:processes.Count -eq 0) { Set-Content (Join-Path $RunDir "processes.json") "[]" }
  else { @($script:processes) | ConvertTo-Json | Set-Content (Join-Path $RunDir "processes.json") }
}
function Register-TrackedProcess($Name, $Port, $Process) {
  $record = @{ name = $Name; port = $Port; pid = $Process.Id; startedAt = $null }
  $script:processes += $record
  Save-ProcessState
  try { $record.startedAt = $Process.StartTime.ToUniversalTime().ToString("O") }
  catch { throw "Could not record process identity for $Name. Verify PID $($Process.Id) manually." }
  Save-ProcessState
}
try {
  if (-not $SkipSkill -and (Test-Path (Join-Path $Root "src/skills"))) {
    $SkillIndex = 0
    foreach ($SkillDir in (Get-ChildItem -Path (Join-Path $Root "src/skills") -Directory)) {
      if (-not (Test-Path (Join-Path $SkillDir.FullName "function_app.py"))) { continue }
      $CurrentSkillPort = $SkillPort + $SkillIndex
      $SkillIndex++
      if (-not (Get-Command uv -ErrorAction SilentlyContinue)) { throw "uv is required to run $($SkillDir.Name)." }
      $func = if (Get-Command func.cmd -ErrorAction SilentlyContinue) { "func.cmd" }
        elseif (Get-Command func -ErrorAction SilentlyContinue) { "func" }
        else { throw "Azure Functions Core Tools is required to run $($SkillDir.Name)." }
      if ($ForceClean -and (Test-Path (Join-Path $SkillDir.FullName ".venv"))) {
        Remove-Item -Recurse -Force (Join-Path $SkillDir.FullName ".venv")
      }
      $skillArgs = if (Test-Path (Join-Path $SkillDir.FullName "pyproject.toml")) {
        @("run", $func, "start", "--port", "$CurrentSkillPort")
      } else {
        @("run", "--with-requirements", "requirements.txt", $func, "start", "--port", "$CurrentSkillPort")
      }
      $skill = Start-Process uv -ArgumentList $skillArgs -WorkingDirectory $SkillDir.FullName -WindowStyle Hidden -PassThru
      Register-TrackedProcess $SkillDir.Name $CurrentSkillPort $skill
      Wait-Port $SkillDir.Name $CurrentSkillPort $skill
    }
  }

  $AgentDir = $null
  if (Test-Path (Join-Path $Root "src/agent/main.py")) {
    $AgentDir = Join-Path $Root "src/agent"
  } elseif (Test-Path (Join-Path $Root "src/agents")) {
    $Candidate = Get-ChildItem -Path (Join-Path $Root "src/agents") -Directory | Where-Object { Test-Path (Join-Path $_.FullName "main.py") } | Select-Object -First 1
    if ($Candidate) { $AgentDir = $Candidate.FullName }
  }
  if ($AgentDir) {
    if (-not (Get-Command uv -ErrorAction SilentlyContinue)) { throw "uv is required to run the backend agent." }
    if ($ForceClean -and (Test-Path (Join-Path $AgentDir ".venv"))) {
      Remove-Item -Recurse -Force (Join-Path $AgentDir ".venv")
    }
    $agent = Start-Process uv -ArgumentList "run", "main.py" -WorkingDirectory $AgentDir -WindowStyle Hidden -PassThru
    Register-TrackedProcess "agent" $AgentPort $agent
    Wait-Port "agent" $AgentPort $agent
  }

  $npxCmd = if ($IsWindows) { "npx.cmd" } else { "npx" }
  $web = Start-Process -FilePath $npxCmd -ArgumentList @("vite", "preview", "--host", "127.0.0.1", "--port", "$WebPort", "--strictPort") -WorkingDirectory $Root -WindowStyle Hidden -PassThru
  Register-TrackedProcess "web" $WebPort $web
  Wait-Port "web" $WebPort $web
  if ($AgentDir) {
    Write-Output "__APP_NAME__ started: web http://localhost:$WebPort, agent http://localhost:$AgentPort"
  } else {
    Write-Output "__APP_NAME__ started: web http://localhost:$WebPort"
  }
} catch {
  Save-ProcessState
  & (Join-Path $PSScriptRoot "dev-stop.ps1")
  throw
}

